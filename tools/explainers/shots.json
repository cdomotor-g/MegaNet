{
 "about": "The screenshots the Videos show: node tools/explainers/shoot.mjs takes them from the site (tools/explainers/README.md, Screenshots). Each target is a part of the page a scene may ring and name; npm run explainers fails a shot whose target is no longer on its page.",
 "shots": [
  {
   "name": "home",
   "path": "?tab=home",
   "ready": "#home-now",
   "targets": {
    "now": "#home-now",
    "status": "#home-now .hm-status",
    "fleets": "#home-now .hm-fleets",
    "most": ".hm-bigs",
    "rest": ".hm-rest"
   }
  },
  {
   "name": "station-card",
   "path": "?tab=stations&station=brisbane_city_al",
   "ready": "[data-tour='station-card']",
   "settle": 4000,
   "store": {
    "mn-map-cluster": "on",
    "mn-hint-display": "1"
   },
   "targets": {
    "card": "[data-tour='station-card']",
    "title": "#stn-card-title",
    "owner": "[data-tour='card-owner']",
    "health": "[data-tour='card-health']",
    "data": "[data-tour='card-data']"
   }
  },
  {
   "name": "health",
   "path": "?tab=health",
   "ready": "#hb-player",
   "settle": 3000,
   "targets": {
    "bulletin": "#hb-player",
    "kinds": ".hb-tools"
   },
   "css": ".hb-bigplay { display: none !important; }"
  },
  {
   "name": "rf",
   "path": "?tab=rf",
   "ready": "#rf-table-wrap",
   "settle": 3000,
   "targets": {
    "byRepeater": "#rf-focus-h",
    "candidates": "#rf-table-wrap"
   }
  },
  {
   "name": "nearby",
   "path": "?tab=nearby",
   "device": "phone",
   "ready": "[data-tour='nearby-list'] .nb-row",
   "settle": 3000,
   "targets": {
    "list": "[data-tour='nearby-list']",
    "first": "[data-tour='nearby-list'] li:first-child",
    "refresh": "#nb-gps"
   }
  },
  {
   "name": "capabilities",
   "path": "?tab=capabilities",
   "ready": "#cap-list",
   "settle": 2500,
   "targets": {
    "facts": "ul.cap-facts",
    "search": "#cap-q",
    "groups": "ul.cap-jump-list",
    "list": "#cap-g-around"
   }
  },
  {
   "name": "search",
   "path": "?tab=stations",
   "ready": "[data-tour='search']",
   "settle": 2500,
   "steps": [
    {
     "click": "[data-tour='search']"
    },
    {
     "wait": 600
    },
    {
     "type": [
      "#pal-q",
      "brisbane city"
     ]
    },
    {
     "wait": 1500
    }
   ],
   "targets": {
    "box": "#pal-q",
    "results": "#pal-list",
    "first": "#pal-list [role='option']"
   },
   "tour": {
    "box": "[data-tour='search']",
    "results": "[data-tour='search']",
    "first": "[data-tour='search']"
   },
   "store": {
    "mn-hint-display": "1"
   }
  },
  {
   "name": "station-card-lower",
   "path": "?tab=stations&station=brisbane_city_al",
   "ready": "[data-tour='station-card']",
   "settle": 4000,
   "steps": [
    {
     "click": "#stn-card .stn-cv-allacts"
    },
    {
     "scroll": "[data-tour='card-position']"
    },
    {
     "wait": 800
    }
   ],
   "targets": {
    "card": "[data-tour='station-card']",
    "position": "[data-tour='card-position']",
    "imagery": "[data-tour='card-imagery-and-terrain']"
   },
   "store": {
    "mn-hint-display": "1"
   }
  }
 ]
}
