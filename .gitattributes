# Certificates are byte-exact material: keep LF on every platform so a Windows
# checkout does not hand CRLF to a firmware toolchain that will not take it.
*.pem text eol=lf

# The Bureau's river height station lists are read by column position
# (tools/ingest/river_height_stations.py): a line ending rewritten on checkout
# is a column moved. Section 9 is an HTML page of <pre> blocks, read the same way.
archive/river-height-stations/*.txt text eol=lf
archive/river-height-stations/*.html text eol=lf

# HDB's peak flood heights extract: its SHA-256 is in data/flood-peaks.json's
# meta, and a line ending rewritten on checkout would make `--check` fail on a
# file nobody changed.
archive/flood-peaks/*.txt text eol=lf

# Batch files are read by cmd.exe, which mis-reads LF-only lines in places.
# The site serves tools/install-rtlsdr-driver.cmd from a checkout, so this
# decides the line ends of the copy people download, not just their own clone.
*.cmd text eol=crlf
