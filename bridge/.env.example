# bridge/.env.example — every setting the bridge reads, with the defaults it
# uses when you leave one out. Copy to .env for local work (and note that .env
# is gitignored: none of the real values below belong in this repository).
#
#   cp .env.example .env && $EDITOR .env && node --env-file=.env index.js
#
# In production, set these as environment variables the platform holds — fly
# secrets, a systemd EnvironmentFile with mode 600, a Docker secret. The two
# that matter are MQTT_PASSWORD and MEGANET_INGEST_TOKEN.

# ── The broker ───────────────────────────────────────────────────────────────
# mqtts:// or wss://, unless MQTT_ALLOW_INSECURE=1. A plain mqtt:// connection
# sends the broker password in clear text over whatever is between here and the
# broker, which is usually the internet.
MQTT_URL=mqtts://your-cluster.hivemq.cloud:8883
MQTT_USERNAME=meganet-bridge
MQTT_PASSWORD=

# The session's name, and the thing that makes "no acked message is lost" true:
# with a stable client id the broker keeps the queue for this bridge while it is
# away. A container that gets a new hostname on every deploy needs this set, or
# every deploy orphans the last session's queued messages.
# MQTT_CLIENT_ID=meganet-bridge-<hostname>

# A private CA, for a self-hosted Mosquitto with a certificate that public roots
# do not chain to. Leave unset for a managed broker.
# MQTT_CA_FILE=/etc/meganet/broker-ca.pem

# Escape hatches. Both are for a bench, and both are named so that finding one
# set in production is finding a decision somebody made.
# MQTT_ALLOW_INSECURE=1   # permit a plain mqtt:// URL
# MQTT_INSECURE_TLS=1     # do not verify the broker's certificate

# MQTT_KEEPALIVE_SEC=60
# MQTT_RECONNECT_BASE_MS=1000
# MQTT_RECONNECT_MAX_MS=60000

# ── MegaNet ──────────────────────────────────────────────────────────────────
# The project's REST base and its publishable key — the same pair app.js holds,
# neither of them a secret.
MEGANET_API_URL=https://jjprlritvhdqpvphfrnu.supabase.co/rest/v1
MEGANET_API_KEY=sb_publishable_PV9VjCM8NQeGAJMuwa5TKA_yX9GWacY

# This one *is* the secret. Mint it with:
#   select meganet.create_ingest_token('mqtt bridge');
# It is shown once. See docs/ingest-mqtt.md.
MEGANET_INGEST_TOKEN=

# MEGANET_TIMEOUT_MS=15000

# ── This process ─────────────────────────────────────────────────────────────
# BRIDGE_ID=<the client id>          which instance this is, in meganet.bridge_health
# BRIDGE_BATCH_MS=1000               how long to gather readings before inserting
# BRIDGE_BATCH_MAX=1000              readings per insert (the endpoint's own limit)
# BRIDGE_RETRY_MAX_MS=60000          longest wait between attempts at a stuck batch
# BRIDGE_HEARTBEAT_MS=60000          how often to update meganet.bridge_health
# BRIDGE_SEEN_INTERVAL_MS=60000      how often to stamp a station's last reading
# BRIDGE_HEALTH_PORT=0               0 is off; set it to serve GET /healthz
# LOG_LEVEL=info                     debug | info | warn | error
