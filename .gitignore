# ACMA raw extract cache — the full spectra_rrl.zip is ~68 MB (580 MB unzipped)
# and must never enter git history. Only the prefiltered subset in data/acma-raw/
# is committed. See README "ACMA RF interference layer".
.acma-cache/
spectra_rrl.zip
acma_subset/

# The web-app test harness (test/) pulls playwright-core, acorn and a local copy
# of Leaflet. Deliberately not at the repo root: docs/floodwarning-net.md:90
# depends on MegaNet staying "static files with no build step", and Cloudflare
# Pages must keep seeing an empty build command. See test/README.md.
test/node_modules/

# tools/ingest/ is plain scripts run with python3, not a package. The bytecode
# cache appears the moment survey.py imports xlsx.py from beside it.
__pycache__/
*.pyc

